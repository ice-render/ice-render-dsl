{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ice-render-dsl core document",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "schemaVersion": { "type": "number" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["rect", "circle", "ellipse", "text", "polyline"]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
