{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ice-render-dsl document",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "schemaVersion": { "type": "number" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "rect",
              "circle",
              "ellipse",
              "text",
              "polyline",
              "image",
              "isogon",
              "star",
              "rose",
              "group"
            ]
          },
          "children": { "type": "array" },
          "left": { "type": "number" },
          "top": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "radius": { "type": "number" },
          "text": { "type": "string" },
          "points": { "type": "array" },
          "src": { "type": "string" },
          "style": { "type": "object" },
          "transform": { "type": "object" },
          "animations": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["polyline", "bezier", "visio"]
          },
          "sourcePort": { "type": "string", "enum": ["T", "R", "B", "L", "C"] },
          "targetPort": { "type": "string", "enum": ["T", "R", "B", "L", "C"] },
          "label": { "type": "string" },
          "style": { "type": "object" }
        }
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "renderMode": { "type": "string", "enum": ["dirty-rect", "full"] },
        "dpr": { "type": "number" },
        "viewport": { "type": "object" },
        "fitViewport": { "type": "boolean" },
        "fitViewportPadding": { "type": "number" }
      }
    }
  },
  "additionalProperties": true
}
